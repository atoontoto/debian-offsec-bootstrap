#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
script=$(readlink -f -- "${BASH_SOURCE[0]}")
bootstrap=$(cd -- "$(dirname -- "$script")/.." && pwd -P)
source "$bootstrap/config/load.sh"; load_offsec_config "$bootstrap"
inventory="$OFFSEC_STATE_ROOT/inventory.json"
[[ -r "$inventory" ]] || { echo 'No inventory yet; run sudo offsec-update or verify.sh.'; exit 0; }
jq . "$inventory"
failures=0
while IFS= read -r executable; do
  link="/usr/local/bin/$executable"
  if [[ ! -L "$link" ]]; then printf 'WARN: missing managed command symlink: %s\n' "$link" >&2; failures=$((failures+1)); continue; fi
  resolved=$(realpath -m -- "$link")
  case "$resolved" in "$OFFSEC_INSTALL_ROOT"/*) ;; *) printf 'WARN: unmanaged command target: %s -> %s\n' "$link" "$resolved" >&2; failures=$((failures+1)); continue ;; esac
  [[ -e "$link" ]] || { printf 'WARN: broken managed command symlink: %s\n' "$link" >&2; failures=$((failures+1)); }
done < <(jq -r '.tools[] | select((.method == "go" or .method == "cargo" or .method == "github") and (.installed or .partial)) | .executables[].name' "$inventory")
((failures == 0))
