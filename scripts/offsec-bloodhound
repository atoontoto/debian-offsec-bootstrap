#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
script=$(readlink -f -- "${BASH_SOURCE[0]}")
bootstrap=$(cd -- "$(dirname -- "$script")/.." && pwd -P)
source "$bootstrap/config/load.sh"; load_offsec_config "$bootstrap"
stack="$OFFSEC_INSTALL_ROOT/stacks/bloodhound"
[[ -f "$stack/compose.yml" && -f "$stack/.env" ]] || { echo 'BloodHound stack is not installed.' >&2; exit 1; }
if docker compose version >/dev/null 2>&1; then compose=(docker compose); elif command -v docker-compose >/dev/null 2>&1; then compose=(docker-compose); else echo 'Docker Compose is not installed.' >&2; exit 1; fi
compose+=(--project-directory "$stack" --env-file "$stack/.env" -f "$stack/compose.yml")
root_run() { if [[ $(id -u) -eq 0 ]]; then "$@"; else sudo -- "$@"; fi; }
set_env() {
  local key="$1" value="$2" tmp
  tmp=$(mktemp "$stack/.env.tmp.XXXXXX")
  awk -F= -v key="$key" '$1 != key {print}' "$stack/.env" > "$tmp"
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  chown root:root "$tmp"; chmod 0600 "$tmp"; mv -f "$tmp" "$stack/.env"
}
case "${1:-}" in
  start) root_run "${compose[@]}" up -d ;;
  stop) root_run "${compose[@]}" stop ;;
  status) root_run "${compose[@]}" ps ;;
  logs) root_run "${compose[@]}" logs --tail 200 ;;
  backup)
    dest="${2:-$OFFSEC_STATE_ROOT/bloodhound-backup-$(date -u +%Y%m%dT%H%M%SZ).sql}"
    [[ "$dest" == /* && "$dest" != / && ! -e "$dest" && -d $(dirname -- "$dest") ]] || { echo "Unsafe or existing backup destination: $dest" >&2; exit 2; }
    backup_tmp=$(root_run mktemp "${dest}.tmp.XXXXXX")
    trap 'root_run rm -f -- "$backup_tmp"' EXIT
    root_run "${compose[@]}" exec -T app-db pg_dump -U bloodhound bloodhound | root_run tee "$backup_tmp" >/dev/null
    root_run chmod 0600 "$backup_tmp"; root_run mv -- "$backup_tmp" "$dest"; trap - EXIT
    echo "PostgreSQL backup written to $dest (Neo4j data requires a stopped volume snapshot)." ;;
  reset-password) if [[ $(id -u) -eq 0 ]]; then exec "$0" _reset-root; else exec sudo -- "$0" _reset-root; fi ;;
  _reset-root)
    [[ $(id -u) -eq 0 ]] || exit 1
    password=$(openssl rand -hex 16)
    set_env BHE_ADMIN_PASSWORD "$password"; set_env BHE_RECREATE_DEFAULT_ADMIN true
    "${compose[@]}" up -d --wait --force-recreate bloodhound
    set_env BHE_RECREATE_DEFAULT_ADMIN false
    "${compose[@]}" up -d --wait --force-recreate bloodhound
    credential_file="$OFFSEC_STATE_ROOT/bloodhound-admin-password"
    umask 077; printf '%s\n' "$password" > "$credential_file"; chmod 0600 "$credential_file"
    echo "Password reset; retrieve it once with: sudo cat $credential_file" ;;
  upgrade) root_run "${compose[@]}" pull; echo 'Images pulled; run start to recreate explicitly.' ;;
  *) echo 'Usage: offsec-bloodhound {start|stop|status|logs|backup [FILE]|reset-password|upgrade}' >&2; exit 2 ;;
esac
